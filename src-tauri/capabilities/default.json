{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app window. The page is served by the local runner, so it's allowed to drag the window.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:5189/*"] },
  "permissions": ["core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize"]
}
