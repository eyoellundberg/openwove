{
  "name": "openwove",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check-flow": "tsx scripts/check-flow.ts",
    "runner": "tsx watch runner/server.ts",
    "mcp": "tsx runner/mcp.ts",
    "site": "vite --config vite.site.config.ts",
    "site:build": "vite build --config vite.site.config.ts",
    "desktop:build": "node scripts/build-desktop.mjs && tauri build",
    "schemas": "tsx scripts/schemas.ts",
    "site:deploy": "npm run site:build && npx wrangler@4 pages deploy",
    "desktop:build:intel": "node scripts/build-desktop.mjs --arch x64 && tauri build --target x86_64-apple-darwin"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
